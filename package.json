{
  "name": "specship",
  "private": true,
  "version": "1.1.0",
  "description": "Product spec tracker that follows a feature from requirement to shipped, with a browser-only demo mode.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/specship.git"
  },
  "homepage": "https://taan1el.github.io/specship/",
  "bugs": {
    "url": "https://github.com/Taan1el/specship/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "lint": "oxlint",
    "start:api": "node dist-server/server/index.js",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "lucide-react": "^1.79.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.95.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  }
}
